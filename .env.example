# copy this file to `.env` and edit as needed

APP_PASSWORD=marekanki
APP_VERSION=2.1.0
PORT=880
MAX_UPLOAD_MB=50
CLEANUP_MINUTES=60
TZ=Europe/Bratislava
OLLAMA_URL=http://127.0.0.1:11434

# Leave blank to disable LLM entirely
OLLAMA_MODELS=phi3:mini,qwen2.5:1.5b

# Optional pretty-names for the dropdown (must be ONE line, fully JSON-encoded)
OLLAMA_MODELS_INFO={"phi3:mini":{"name":"Phi-3 Mini (3.8B)","quality":"fast, low-RAM","notes":"Great for quick glosses."},"qwen2.5:1.5b":{"name":"Qwen2.5-1.5B","quality":"tiny, multilingual","notes":"Super-light but lower context understanding."}}

# --- OpenAI (optional) ---
# If OPENAI_API_KEY is not set, OPENAI_MODELS will be ignored and not shown in UI.
OPENAI_API_KEY=sk-...
OPENAI_MODELS=gpt-4o-mini,gpt-4o
# Optional pretty names/info (same shape as OLLAMA_MODELS_INFO)
OPENAI_MODELS_INFO={
  "gpt-4o-mini": {"name":"GPT-4o mini","quality":"fast, cheap","notes":"Great price/perf for short glosses."},
  "gpt-4o": {"name":"GPT-4o","quality":"high quality","notes":"Best overall quality."}
}